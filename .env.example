#################################################
# APPLICATION
#################################################
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5170
AllowedHosts=localhost;127.0.0.1

#################################################
# API
#################################################
# API route prefix/version are fixed public contracts: /api/auth. They are not
# runtime settings. Registration can be disabled with the feature flag below.

#################################################
# DATABASE
#################################################
ConnectionStrings__DefaultConnection=Server=(localdb)\MSSQLLocalDB;Database=AuthServiceDb;Trusted_Connection=True;MultipleActiveResultSets=true

#################################################
# AUTHENTICATION
#################################################
# Supply this secret through .NET User Secrets locally or a secrets manager.
# Do not put a real key in a committed env file.
# Jwt__SecretKey=
Jwt__Issuer=AuthService
Jwt__Audience=AuthServiceClient
Jwt__AccessTokenExpirationMinutes=15
Jwt__RefreshTokenExpirationDays=7

#################################################
# IDENTITY POLICY
#################################################
Identity__Password__RequireDigit=true
Identity__Password__RequiredLength=8
Identity__Password__RequireNonAlphanumeric=false
Identity__Password__RequireUppercase=true
Identity__Password__RequireLowercase=true
Identity__User__RequireUniqueEmail=true
Identity__SignIn__RequireConfirmedEmail=false

#################################################
# SECURITY
#################################################
# AllowedHosts is configured in the APPLICATION section.
# CORS, session state, application-level encryption, and a separate refresh-token
# signing key are not implemented. Refresh tokens are random opaque values.

#################################################
# RATE LIMITING
#################################################
IpRateLimiting__EnableEndpointRateLimiting=true
IpRateLimiting__StackBlockedRequests=false
IpRateLimiting__RealIpHeader=X-Real-IP
IpRateLimiting__ClientIdHeader=X-ClientId
IpRateLimiting__HttpStatusCode=429
IpRateLimiting__GeneralRules__0__Endpoint=*
IpRateLimiting__GeneralRules__0__Period=1m
IpRateLimiting__GeneralRules__0__Limit=60
IpRateLimiting__GeneralRules__1__Endpoint=POST:/api/auth/login
IpRateLimiting__GeneralRules__1__Period=1m
IpRateLimiting__GeneralRules__1__Limit=5

#################################################
# CACHE
#################################################
# No external cache provider is implemented. In-memory rate-limit counters
# are process-local and use the framework's memory cache.

#################################################
# STORAGE
#################################################
# No upload or object-storage feature is implemented.

#################################################
# EMAIL
#################################################
# No SMTP/email sender is implemented. Email confirmation is configurable
# under Identity but there is currently no email-delivery integration.

#################################################
# LOGGING
#################################################
Serilog__MinimumLevel__Default=Information
Serilog__MinimumLevel__Override__Microsoft=Warning
Serilog__MinimumLevel__Override__System=Warning
# Optional. Leave empty or omit to log to console only.
Logging__FilePath=logs/auth-service-.log
Logging__FileRollingInterval=Day

#################################################
# MONITORING
#################################################
# No metrics, tracing, Sentry, or health-check provider is configured.

#################################################
# AI CONFIGURATION
#################################################
# No AI provider or model integration is present.

#################################################
# CLOUD
#################################################
# Cloud credentials and resource identifiers are not consumed by this project.

#################################################
# FEATURE FLAGS
#################################################
Features__RegistrationEnabled=true
# Analytics and email-notification features are not implemented.

#################################################
# DEPLOYMENT
#################################################
# Image names and Kubernetes namespaces belong in deployment manifests/pipeline
# variables. This repository has no Docker/Kubernetes deployment definitions.
