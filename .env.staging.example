#################################################
# APPLICATION
#################################################
ASPNETCORE_ENVIRONMENT=Staging
ASPNETCORE_URLS=http://0.0.0.0:8080
AllowedHosts=auth-staging.example.invalid

#################################################
# API
#################################################
# The API route prefix/version are fixed public contracts: /api/auth.

#################################################
# DATABASE
#################################################
# Replace with a staging SQL Server connection. Supply credentials via the
# platform secret store, not this file.
ConnectionStrings__DefaultConnection=Server=tcp:<staging-sql-host>,1433;Initial Catalog=AuthServiceStaging;Encrypt=True;TrustServerCertificate=False;MultipleActiveResultSets=True

#################################################
# AUTHENTICATION
#################################################
# Inject Jwt__SecretKey from the staging secret manager.
Jwt__Issuer=AuthService-Staging
Jwt__Audience=AuthService-Staging-Clients
Jwt__AccessTokenExpirationMinutes=15
Jwt__RefreshTokenExpirationDays=7

#################################################
# IDENTITY POLICY
#################################################
Identity__Password__RequireDigit=true
Identity__Password__RequiredLength=8
Identity__Password__RequireNonAlphanumeric=false
Identity__Password__RequireUppercase=true
Identity__Password__RequireLowercase=true
Identity__User__RequireUniqueEmail=true
Identity__SignIn__RequireConfirmedEmail=false

#################################################
# RATE LIMITING
#################################################
IpRateLimiting__EnableEndpointRateLimiting=true
IpRateLimiting__StackBlockedRequests=false
IpRateLimiting__RealIpHeader=X-Real-IP
IpRateLimiting__ClientIdHeader=X-ClientId
IpRateLimiting__HttpStatusCode=429
IpRateLimiting__GeneralRules__0__Endpoint=*
IpRateLimiting__GeneralRules__0__Period=1m
IpRateLimiting__GeneralRules__0__Limit=120
IpRateLimiting__GeneralRules__1__Endpoint=POST:/api/auth/login
IpRateLimiting__GeneralRules__1__Period=1m
IpRateLimiting__GeneralRules__1__Limit=10

#################################################
# LOGGING
#################################################
Serilog__MinimumLevel__Default=Information
Serilog__MinimumLevel__Override__Microsoft=Warning
Serilog__MinimumLevel__Override__System=Warning

#################################################
# FEATURE FLAGS
#################################################
Features__RegistrationEnabled=true
